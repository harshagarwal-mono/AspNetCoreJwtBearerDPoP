# Root .editorconfig file
root = true

########################################################
# Global Rules
########################################################
[*]
end_of_line = lf
insert_final_newline = true

########################################################
# General Formatting
########################################################
[*.cs]

indent_style = space
indent_size = 4

# Treat analyzer warnings as errors (so build fails on violations)
dotnet_analyzer_diagnostic.severity = error

########################################################
# Using Directives
########################################################

# Place 'using' directives outside namespace
csharp_using_directive_placement = outside_namespace:error

# Sort System.* directives first, then others
dotnet_sort_system_directives_first = true

# Remove unused usings
dotnet_diagnostic.IDE0005.severity = error   # unused using
dotnet_diagnostic.IDE0065.severity = error   # misplaced using
dotnet_diagnostic.IDE0055.severity = error   # formatting (includes sort)
dotnet_diagnostic.IDE0046.severity = none    # conditional expression with simplified ifs
dotnet_diagnostic.IDE0058.severity = none    # Expression value is never used
dotnet_diagnostic.IDE0072.severity = suggestion   # Add missing cases
dotnet_diagnostic.CA1848.severity = none     # Suppress performance warning for LoggerMessage


########################################################
# Braces & Code Style
########################################################

# Always require braces
csharp_prefer_braces = true:error

# Prefer explicit types except when type is obvious
csharp_style_var_when_type_is_apparent = true:error
csharp_style_var_elsewhere = false:error
csharp_style_var_for_built_in_types = false:error

########################################################
# Naming Conventions
########################################################

# --- Interfaces: I + PascalCase ---
dotnet_naming_rule.interfaces_should_be_ipascalcase.severity = error
dotnet_naming_rule.interfaces_should_be_ipascalcase.symbols  = interfaces
dotnet_naming_rule.interfaces_should_be_ipascalcase.style    = ipascalcase

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *
dotnet_naming_style.ipascalcase.capitalization = pascal_case
dotnet_naming_style.ipascalcase.required_prefix = I

# --- Classes, Properties, Methods: PascalCase ---
dotnet_naming_rule.types_methods_props_pascalcase.severity = error
dotnet_naming_rule.types_methods_props_pascalcase.symbols  = types_methods_props
dotnet_naming_rule.types_methods_props_pascalcase.style    = pascalcase

dotnet_naming_symbols.types_methods_props.applicable_kinds = class, struct, property, method
dotnet_naming_symbols.types_methods_props.applicable_accessibilities = *
dotnet_naming_style.pascalcase.capitalization = pascal_case

# --- Private fields: _camelCase ---
dotnet_naming_rule.private_fields_underscore_camelcase.severity = error
dotnet_naming_rule.private_fields_underscore_camelcase.symbols  = private_fields
dotnet_naming_rule.private_fields_underscore_camelcase.style    = underscorecamelcase

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, protected
dotnet_naming_symbols.private_fields.required_modifiers =

dotnet_naming_style.underscorecamelcase.capitalization = camel_case
dotnet_naming_style.underscorecamelcase.required_prefix = _

# --- Public fields and events must use PascalCase (e.g., OnHttpResponse) ---
dotnet_naming_rule.public_members_must_be_pascalcase.symbols = public_fields_and_events
dotnet_naming_rule.public_members_must_be_pascalcase.style = pascalcase_style
dotnet_naming_rule.public_members_must_be_pascalcase.severity = error

# Symbol group: includes public fields and events
dotnet_naming_symbols.public_fields_and_events.applicable_kinds = field, event
dotnet_naming_symbols.public_fields_and_events.applicable_accessibilities = public

# --- Enums: PascalCase ---
dotnet_naming_rule.enums_pascalcase.severity = error
dotnet_naming_rule.enums_pascalcase.symbols  = enums
dotnet_naming_rule.enums_pascalcase.style    = pascalcase

dotnet_naming_symbols.enums.applicable_kinds = enum
dotnet_naming_symbols.enums.applicable_accessibilities = *

# --- Constants: PascalCase ---
dotnet_naming_rule.constants_pascalcase.severity = error
dotnet_naming_rule.constants_pascalcase.symbols  = constants
dotnet_naming_rule.constants_pascalcase.style    = pascalcase

dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_symbols.constants.applicable_accessibilities = *

# --- Local functions: PascalCase ---
dotnet_naming_rule.local_functions_pascalcase.severity = error
dotnet_naming_rule.local_functions_pascalcase.symbols  = local_functions
dotnet_naming_rule.local_functions_pascalcase.style    = pascalcase

dotnet_naming_symbols.local_functions.applicable_kinds = local_function
dotnet_naming_symbols.local_functions.applicable_accessibilities = *

########################################################
# Namespace Style
########################################################

# Prefer file-scoped namespaces (namespace Foo;)
csharp_style_namespace_declarations = file_scoped:error

# Always enforce namespace-to-folder matching (disable IDE0130)
dotnet_diagnostic.IDE0130.severity = error


########################################################
# Test Projects / Test Methods Naming Rules
# Applies to files like *.Tests.cs or *Tests.cs
########################################################

# CA1873: Avoid potentially expensive logging
dotnet_diagnostic.CA1873.severity = none

[*.Tests.cs]
[**/*Tests.cs]

# Symbol: all methods in test files
dotnet_naming_symbols.test_methods.applicable_kinds = method
dotnet_naming_symbols.test_methods.applicable_accessibilities = *
dotnet_naming_symbols.test_methods.required_modifiers =

# Style: PascalCase with underscores allowed (Pascal_Case)
dotnet_naming_style.test_method_pascal_underscore.capitalization = pascal_case
dotnet_naming_style.test_method_pascal_underscore.required_prefix =
dotnet_naming_style.test_method_pascal_underscore.required_suffix =
dotnet_naming_style.test_method_pascal_underscore.word_separator = _

# Rule: apply style to test methods
dotnet_naming_rule.test_methods_allow_underscores.severity = suggestion
dotnet_naming_rule.test_methods_allow_underscores.symbols = test_methods
dotnet_naming_rule.test_methods_allow_underscores.style = test_method_pascal_underscore

# Disable CA1707 (no underscores rule) for test files
dotnet_diagnostic.CA1707.severity = none

# Allow skipped tests in test projects
dotnet_diagnostic.xUnit1004.severity = none
